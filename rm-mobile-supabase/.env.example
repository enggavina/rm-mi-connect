# Scripts de ETL e sincronização usam o runtime do desktop.
# Copie os valores para desktop/.env, ou injete no processo Node do worker.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SOMENTE-NO-SERVIDOR
BUBBLE_API_BASE_URL=https://rm.miconnect.app.br/version-test/api/1.1
# Para produção autorizada: https://rm.miconnect.app.br/api/1.1
BUBBLE_API_TOKEN=TOKEN-DATA-API-DO-AMBIENTE
BUBBLE_SYNC_ID_FIELD=supabase_id
# URLs exatas autorizadas, separadas por vírgula. Não versionar URLs com tokens.
SYNC_WEBHOOK_ALLOWLIST=
# Veja desktop/.env.example para todas as opções suportadas.
