# Server only. Never prefix these secrets with NEXT_PUBLIC_ or EXPO_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
# Server-side SSR uses the public anon key, never the service-role key.
SUPABASE_ANON_KEY=your-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=
# Prepared schema is in Main/test. Switch to /api/1.1 only after production schema deploy.
BUBBLE_API_BASE_URL=https://rm.miconnect.app.br/version-test/api/1.1
BUBBLE_API_TOKEN=
# Random independent secrets of at least 32 characters.
BUBBLE_WEBHOOK_SECRET=
INTERNAL_API_SECRET=
# Add this text field to each Bubble type written by the bridge before enabling it.
# It is the external idempotency key for recovery after ambiguous POST responses.
BUBBLE_SYNC_ID_FIELD=supabase_id
# Optional map for Data API type names that differ from the supplied documentation.
BUBBLE_ENDPOINT_OVERRIDES={}
SYNC_POLL_INTERVAL_MS=15000
# Keep disabled during read-only import/validation. Enable explicitly at cutover.
SYNC_OUTBOX_ENABLED=false
SYNC_INITIAL_CURSOR=1970-01-01T00:00:00.000Z
# Only exact allowed HTTPS webhook URLs can be called. Comma-separated.
SYNC_WEBHOOK_ALLOWLIST=
# Optional dedicated Bearer token for the legacy n8n service.
N8N_WEBHOOK_TOKEN=
# Long-running worker runs as a second Railway service: npm run worker
# Web app port is supplied by Railway.
PORT=3000
