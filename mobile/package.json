{
  "name": "rm-mi-connect-mobile",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:native": "expo export --platform android --platform ios --output-dir dist-native"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@noble/hashes": "^1.8.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@supabase/supabase-js": "2.109.0",
    "decode-uri-component": "file:./vendor/decode-uri-component",
    "expo": "~54.0.0",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "image-size": "file:./vendor/image-size-compat",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "4.0.3"
  },
  "overrides": {
    "postcss": "8.5.32",
    "image-size": "$image-size",
    "decode-uri-component": "$decode-uri-component"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/node": "^22.0.0",
    "image-size-modern": "npm:image-size@2.0.4",
    "typescript": "~5.9.2",
    "tsx": "^4.20.0"
  }
}
